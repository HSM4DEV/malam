# ===========================================================================
# مَعلم (Ma'lam) — environment variables
# Copy to `.env` and fill in real values. Never commit `.env`.
# ===========================================================================

# --- Database: Supabase PostgreSQL + Prisma --------------------------------
#
# Two connection strings (Supabase → Project Settings → Database → Connect):
#
#   DATABASE_URL — runtime queries. Use the "Transaction" pooler (Supavisor,
#   port 6543). Serverless-safe. Append `?pgbouncer=true`.
#
#   DIRECT_URL — migrations & seeding. Use the "Session"/direct connection
#   (port 5432). Required by `prisma migrate` and `prisma db seed`.
#
# Replace [YOUR-PASSWORD], [PROJECT-REF], and [REGION] with your values.

DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# --- Auth.js / NextAuth -----------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET="replace-with-output-of-npx-auth-secret"
# Public base URL of the app (required in production).
# AUTH_URL="https://your-domain.com"

# --- Supabase Storage (object storage for imagery) -------------------------
# Supabase → Project Settings → API. The service-role key is server-only —
# never expose it to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="project-images"
